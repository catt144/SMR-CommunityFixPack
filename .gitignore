# Mod Editor / game-generated artifacts (if the game writes into the mod folder)
*.log
ModContent.hpk
Previews/

# tools/ is importable, so anything that imports doccheck leaves bytecode here
__pycache__/
*.pyc

# OS
Thumbs.db
Desktop.ini
# .claude/ is local scratch and never committed -- except the skills, which are
# project material both vendors load (mirrored to .agents/skills/ by --regen).
.claude/*
!.claude/skills/

# Owner-only scratch. NOT for agents: nothing in the repo points here, and no
# session reads it unless the owner names it in a prompt. Mirrors the same folder
# in the Subathon Timer repo. Holds a junction to the Claude memory store.
zz-owner/
