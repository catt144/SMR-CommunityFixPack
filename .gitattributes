# core.autocrlf is true in this clone, so anything git checks out gets CRLF
# unless told otherwise. A shell script with CRLF endings dies on its own
# shebang (`/bin/sh^M: bad interpreter`), silently, on a fresh clone — so the
# hooks are pinned to LF.
tools/hooks/* text eol=lf

# Keep STATE checkouts stable. Since ck170, doccheck normalizes CRLF to LF
# before budget accounting, including after a session writes CRLF back.
# This pin alone previously failed to prevent a line-ending-based diagnosis.
docs/agent/STATE.md text eol=lf

# Append-only companions preserve this sweep's original mixed log line endings.
# Recorded SHA256 hashes describe these raw bytes; readable .log blobs normalize.
docs/archive/logs/stillneeded_*.log.raw -text
